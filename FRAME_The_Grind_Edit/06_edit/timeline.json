    { "file": "03_sfx/individual/drop_impact.wav", "at": 5.6, "gain_db": 0 },
    { "file": "03_sfx/individual/whoosh_wipe.wav", "center_at": 21.6, "gain_db": -4 },
    { "file": "03_sfx/individual/roll_swish.wav", "center_at": 23.6, "gain_db": -4 },
    { "file": "03_sfx/individual/clone_glitch.wav", "at": 24.8, "gain_db": -6 },
    { "file": "03_sfx/individual/flash_hit.wav", "at": 25.6, "gain_db": -2 },
    { "file": "03_sfx/individual/drone_bed.wav", "at": 25.6, "gain_db": -6, "until": 30.0 }
  ],
  "grade": {
    "order": ["log_to_rec709 (LUT if supplied in 06_edit/luts)", "teal shadows / amber highlights", "blacks crushed slightly", "saturation -15%", "halation on city lights + laptop", "35mm grain ~15%", "soft vignette"],
    "arc": "S03-S08 warm golden -> S01/S02/S09/S10 cold blue hour -> S11/S12 night with amber city lights -> S13 cool dawn"
  },
  "exports": [
    "07_exports/FRAME_TheGrind_final.mp4  (H.264 high, yuv420p, CRF 16, AAC 320k, +faststart)",
